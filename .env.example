# Runtime selection. Copy this file to .env and adjust it for this machine.
SPECTER_SENSE_CONFIG=config/specter-sense.example.json
SPECTER_SENSE_SOURCE=synthetic

# Leave blank to use $XDG_RUNTIME_DIR/specter-sense.sock; use "off" to disable it.
SPECTER_SENSE_SOCKET=
SPECTER_SENSE_SOCKET_INTERVAL_MS=100

# State is socket-only by default. Set a path to also keep a JSON snapshot.
SPECTER_SENSE_OUTPUT=

# Normally unlimited. This is useful for synthetic smoke runs.
SPECTER_SENSE_FRAMES=0
